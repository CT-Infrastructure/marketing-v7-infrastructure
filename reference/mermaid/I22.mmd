flowchart TB
  IN["I22: Scheduled review or vulnerability<br/>notification"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Inventory pinned images, packages, nodes and<br/>model licenses<br/><b>Ansible / Forgejo</b>"]:::process
  IN --> S1
  S2["Scan selected artifacts and review<br/>severity/exposure<br/><b>Trivy</b>"]:::process
  S1 --> S2
  S3["Build reviewed patched versions and<br/>migration plan<br/><b>Forgejo / Ansible</b>"]:::process
  S2 --> S3
  S4["Test backup, staging behavior and rollback<br/><b>Playwright / isolated restore</b>"]:::process
  S3 --> S4
  GATE{"Staging, recovery and owner approval<br/>passed?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Approve bounded maintenance and post-checks<br/><b>OpenProject / unattended-upgrades policy</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Traceable patch release with rollback<br/>boundary"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>I23, I24, I33"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

