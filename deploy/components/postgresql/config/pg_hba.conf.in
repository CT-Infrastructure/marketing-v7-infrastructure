# Local administration only by mapped peer identity, never trust.
local all postgres peer
local all all reject
hostnossl all all 0.0.0.0/0 reject
hostnossl all all ::/0 reject
# Exact private app CIDRs are controller-rendered; no host publishing.
hostssl app_a app_a_runtime,app_a_migrator UNRESOLVED_APP_A_CIDR scram-sha-256
hostssl app_b app_b_runtime,app_b_migrator UNRESOLVED_APP_B_CIDR scram-sha-256
host all all 0.0.0.0/0 reject
host all all ::/0 reject
